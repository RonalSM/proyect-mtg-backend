# Environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL URL provided by Render or Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public&sslmode=disable

# Authentication Secrets (minimum 32 characters)
SESSION_SECRET=mtgc_session_secret_min_32_characters_long_for_production
JWT_SECRET=mtgc_jwt_secret_min_32_characters_long_for_security_production

# Scryfall API User Agent
SCRYFALL_USER_AGENT=MTGCommanderVirtualTable/1.0.0 (admin@mtgc.local)
